# ==============================================================================
# ODOO DOCKER ENVIRONMENT CONFIGURATION EXAMPLE
# Copy this file to .env and configure the variables for local or staging
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (PostgreSQL)
# ------------------------------------------------------------------------------
POSTGRES_DB=postgres
POSTGRES_USER=odoo
# Thay đổi mật khẩu này khi triển khai lên Staging/Production
POSTGRES_PASSWORD=odoo_secure_db_pass_123
# Cổng để map ra bên ngoài từ Container Postgres (để connect từ ngoài nếu cần)
POSTGRES_EXTERNAL_PORT=5435

# ------------------------------------------------------------------------------
# 2. ODOO CONFIGURATION
# ------------------------------------------------------------------------------
# Mật khẩu quản trị tối cao của Odoo (dùng để tạo/backup/restore database)
ODOO_ADMIN_PASSWORD=odoo_super_admin_pass_456
# Môi trường chạy (development / staging / production)
ENVIRONMENT=development
LOG_LEVEL=info

# Các biến kết nối DB mà Odoo Container sẽ đọc
DB_HOST=db
DB_PORT=5432
DB_USER=odoo
DB_PASSWORD=odoo_secure_db_pass_123

# ------------------------------------------------------------------------------
# 3. WEB SERVER CONFIGURATION (Nginx & Routing)
# ------------------------------------------------------------------------------
# Cổng HTTP của Nginx (truy cập Odoo qua cổng này)
HTTP_PORT=80
# Cổng HTTPS (nếu cấu hình SSL trực tiếp ở Nginx)
HTTPS_PORT=443

# Cổng Odoo Local (nếu muốn truy cập trực tiếp Odoo không qua Nginx)
ODOO_PORT=8069
# Cổng Odoo Longpolling (cho tính năng chat real-time)
ODOO_CHAT_PORT=8072
